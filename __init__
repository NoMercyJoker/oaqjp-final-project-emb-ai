import requests
from flask import Flask, request, jsonify

app = Flask(__name__)

url = "https://sn-watson-emotion.labs.skills.network/v1/watson.runtime.nlp.v1/NlpService/EmotionPredict"
headers = {
    "grpc-metadata-mm-model-id": "emotion_aggregated-workflow_lang_en_stock",
    "Content-Type": "application/json"
}

def emotion_detector(text_to_analyse):
    input_json = {
        "raw_document": {
            "text": text_to_analyse
        }
    }
    response = requests.post(url, headers=headers, json=input_json)
    if response.status_code == 200:
        return response.json()  # Return the emotion prediction result
    else:
        return {"error": f"API request failed with status code {response.status_code}"}

@app.route('/analyze', methods=['POST'])
def analyze():
    data = request.get_json()
    if not data or 'text' not in data:
        return jsonify({"error": "Missing 'text' in request"}), 400

    text_to_analyse = data['text']

    # Call your emotion_detector function that returns the full response dict
    response_data = emotion_detector(text_to_analyse)

    # Extract emotion scores from nested structure
    try:
        emotions = response_data['emotionPredictions'][0]['emotion']
    except (KeyError, IndexError) as e:
        return jsonify({"error": "Unexpected API response structure", "details": str(e), "response": response_data}), 500

    # Calculate dominant emotion
    dominant_emotion = max(emotions, key=emotions.get)

    # Prepare result with all emotion scores + dominant emotion
    result = emotions.copy()
    result['dominant_emotion'] = dominant_emotion

    return jsonify(result)

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)
